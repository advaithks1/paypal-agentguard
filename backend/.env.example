# Copy to backend/.env and fill in. NEVER commit backend/.env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: needed for webhook signature verification. If empty, the app falls back to polling the order.
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./agentguard.db

# Phase 1: authorize now, capture after human approval
# auto = AUTHORIZE for needs_approval requests, CAPTURE for auto-approved ones; or force authorize | capture
PAYMENT_MODE=auto
# Flag a PayPal hold as "expiring soon" when fewer than this many hours remain
AUTH_EXPIRY_WARN_HOURS=48

# Phase 3: MCP agents
MCP_RATE_LIMIT_PER_MINUTE=30

# Used by scripts/mcp_server.py / mcp_client_demo.py (stdio agents), NOT read by the backend itself.
# Create the key in the UI (Agents page), shown once. Put it in the MCP client config, never in git.
# AGENTGUARD_API_KEY=agk_...
