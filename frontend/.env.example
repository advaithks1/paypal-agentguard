# Public config only. NEVER add PayPal secrets, Gemini keys or JWT secrets here: anything in VITE_* is shipped to the browser.
# Base URL of the FastAPI backend (must match the backend's FRONTEND_ORIGIN CORS setting).
VITE_API_BASE_URL=http://localhost:8000/api/v1
# 'api'  = real backend: real login, real policy engine, real PayPal Sandbox checkout (use this for the demo video).
# 'demo' = no backend needed: clearly labelled in-browser simulation. PayPal checkout and the Policy Copilot are disabled.
VITE_DATA_MODE=api
